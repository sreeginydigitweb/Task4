# Task 4 - Product Keywords. Connection to the source database.
#
# Copy this file to product-keywords/.env and fill in the values. .env is
# ignored by git (see .gitignore); this template is not, and must never
# contain a real password, host or user.
#
# ---------------------------------------------------------------------------
# ONE DATABASE, READ-ONLY
#
# `ledsone` is an existing business database. This application reports on it
# and never writes to it. Three things keep that true, and all three are in
# place:
#
#   1. Every statement in the codebase is a SELECT. There is no INSERT,
#      UPDATE, DELETE, CREATE, ALTER, DROP or TRUNCATE anywhere in it, and no
#      add, edit or delete screen to reach one from.
#
#   2. The pool sets `default_transaction_read_only = on` as a connection
#      option, so the SERVER refuses a write on this connection regardless of
#      what the application asks for.
#
#   3. DB_USER below should be a role with SELECT and nothing else on the
#      schemas named at the foot of this file. The application checks this at
#      startup and REFUSES TO START if the role turns out to hold INSERT,
#      UPDATE or DELETE on inventory.products.
#
# Point DB_USER at a role that can write, and the application will stop rather
# than run. That is deliberate.
#
# There is no schema to create, no migration to run and no seed step. The
# source database already holds the data; this application only reads it.
#
# There is also no second database. Competitor and classified-keyword tables
# exist elsewhere in the estate, in `order_management_copy`; this version does
# not read them and has no setting that could reach them.

DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=

# The source database. This must be ledsone.
DB_NAME=ledsone

# true when the server requires TLS. The certificate is self-signed, so the
# connection is encrypted but the chain is not verified - sslmode=require, not
# verify-full.
DB_SSL=true

# Optional. Most connections the pool will open. Defaults to 2.
#
# Keep it small. This role is shared with the other applications on this
# server and has one connection limit covering all of them, so an oversized
# pool here can exhaust the role and refuse every application a connection -
# this one included, at startup.
# DB_POOL_MAX=2

# Optional. The schemas read. The defaults are the real ones and there is no
# reason to change them outside a test rig.
#
#   DB_INVENTORY_SCHEMA  products: SKU, product id, product name
#   DB_LISTINGS_SCHEMA   amazon_listings and amazon_listing_search_engine_keywords
#   DB_ORDERS_SCHEMA     sub_source and source: the platform behind each listing
#
# DB_INVENTORY_SCHEMA=inventory
# DB_LISTINGS_SCHEMA=listings
# DB_ORDERS_SCHEMA=order_management

# Optional. Port the HTTP server listens on. Defaults to 3100.
# PRODUCT_KEYWORDS_PORT=3100
